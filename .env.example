# Database (Neon PostgreSQL)
DATABASE_URL=
DIRECT_URL=

# Auth
AUTH_SECRET=
AUTH_URL=http://localhost:3000
#
# AUTH_SECRET is required in production (minimum 32 characters).
# Generate with: openssl rand -base64 32

# Admin seed helper (development)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Object storage — local development default
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=
LOCAL_STORAGE_PUBLIC_URL_BASE=/media

# Object storage — production (Cloudflare R2 via S3-compatible API)
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=engineering-platform-assets
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL_BASE=https://media.devlaunchsystems.com
# S3_PUBLIC_URL_BASE_EXTRA=https://pub-xxxx.r2.dev
#
# S3_PUBLIC_URL_BASE is the browser-facing delivery URL. Protocol may be omitted
# (media.example.com) and will be normalized to https. Use S3_PUBLIC_URL_BASE_EXTRA
# for additional next/image hosts during R2 dev → custom-domain transition.
#
# S3_ENDPOINT is the S3-compatible API endpoint only — never use it for
# public image URLs in the app.

# Shared project read provider (Phase 10)
# Default: database (Portfolio Neon). Explicit operator selection required for API reads.
# PROJECT_READ_SOURCE=database
# PROJECT_READ_SOURCE=platform-api
# DEVLAUNCH_PLATFORM_API_URL=https://api.devlaunchsystems.com
# DEVLAUNCH_PLATFORM_API_TIMEOUT_MS=5000

# Shared project write provider (Phase 11 / M17 frozen)
# Legacy Prisma shared-content writes are frozen. PROJECT_WRITE_SOURCE must be platform-api.
# PROJECT_WRITE_SOURCE=platform-api
# DEVLAUNCH_PLATFORM_API_TOKEN=
#
# DEVLAUNCH_PLATFORM_API_TOKEN is server-side only. Never expose it to the browser.
