{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && bun run --bun next dev --turbopack",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "migrate:content": "bun run scripts/migrate-content.ts",
    "seed:admin": "bun run scripts/seed-admin.ts",
    "backfill:portfolio-slugs": "bun run scripts/backfill-portfolio-slugs.ts",
    "ci": "npm run audit:production && npm run lint && npm run db:migrate:deploy && npx prisma validate && npm run build",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "ci:install": "npm ci && npm run ci",
    "ci:github": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ci NEXTAUTH_SECRET=ci-placeholder-secret-min-32-chars-long!! NEXTAUTH_URL=http://localhost:3000 npm run ci"
  },
