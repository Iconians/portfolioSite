// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  articles    Article[]
  reviews     Review[]
  portfolio   Portfolio[]
  mediaAssets MediaAsset[]

  @@map("users")
}

model MediaAsset {
  id              String   @id @default(uuid())
  filename        String
  storageKey      String   @unique @map("storage_key")
  publicUrl       String   @map("public_url")
  mimeType        String   @map("mime_type")
  sizeBytes       Int      @map("size_bytes")
  width           Int?
  height          Int?
  altText         String?  @map("alt_text")
  caption         String?  @db.Text
  storageProvider String   @map("storage_provider")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String   @map("created_by")
  createdByUser   User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  portfolioHeroFor Portfolio[] @relation("PortfolioHeroMedia")
  portfolioOgFor   Portfolio[] @relation("PortfolioOgMedia")
  articleCoversFor Article[] @relation("ArticleCoverMedia")

  @@index([createdAt(sort: Desc)], name: "media_assets_created_at_idx")
  @@map("media_assets")
}

model Article {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  content       String    @db.Text
  description   String?   @db.Text
  date          DateTime
  tags          String[]
  featured      Boolean   @default(false)
  status        String    @default("draft") // draft | published | archived
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  publishedAt   DateTime? @map("published_at")
  coverMediaId  String?   @map("cover_media_id")
  createdBy     String    @map("created_by")
  createdByUser User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  coverMedia    MediaAsset? @relation("ArticleCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)

  @@index([slug], name: "articles_slug_idx")
  @@index([featured, status], name: "articles_featured_idx")
  @@index([date(sort: Desc), status], name: "articles_date_idx")
  @@index([status], name: "articles_status_idx")
  @@map("articles")
}

model Review {
  id            String   @id @default(uuid())
  title         String
  content       String   @db.Text
  stars         Int // 1-5
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     String   @map("created_by")
  createdByUser User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Portfolio {
  id                   String    @id @default(uuid())
  img                  String
  caption              String
  description          String    @db.Text
  category             String[]
  url                  String?
  github               String?
  keyFeatures          String?   @map("key_features")
  role                 String?   @db.Text
  highlights           String?   @db.Text
  projectType          String?   @map("project_type")
  slug                 String?   @unique
  subtitle             String?
  summary              String?   @db.Text
  problem              String?   @db.Text
  solution             String?   @db.Text
  architecture         String?   @db.Text
  challenges           String?   @db.Text
  lessonsLearned       String?   @map("lessons_learned") @db.Text
  futureImprovements   String?   @map("future_improvements") @db.Text
  lifecycleStatus      String    @default("active") @map("lifecycle_status")
  publishStatus        String    @default("published") @map("publish_status")
  startDate            DateTime? @map("start_date")
  endDate              DateTime? @map("end_date")
  sortOrder            Int       @default(0) @map("sort_order")
  gallery              Json      @default("[]")
  features             Json      @default("[]")
  responsibilities     Json      @default("[]")
  showPlatformSection  Boolean   @default(false) @map("show_platform_section")
  platformFeatures     String[]  @default([]) @map("platform_features")
  seoTitle             String?   @map("seo_title")
  seoDescription       String?   @map("seo_description") @db.Text
  docs                 String?
  heroMediaId          String?   @map("hero_media_id")
  ogMediaId            String?   @map("og_media_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  createdBy            String    @map("created_by")
  createdByUser        User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  heroMedia            MediaAsset? @relation("PortfolioHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull)
  ogMedia              MediaAsset? @relation("PortfolioOgMedia", fields: [ogMediaId], references: [id], onDelete: SetNull)
  metrics              PortfolioMetric[]
  versions             ProjectVersion[]

  @@index([slug], name: "portfolio_slug_idx")
  @@index([publishStatus], name: "portfolio_publish_status_idx")
  @@map("portfolio")
}

model PortfolioMetric {
  id           String   @id @default(uuid())
  portfolioId  String   @map("portfolio_id")
  label        String
  value        String
  description  String?  @db.Text
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, displayOrder], name: "portfolio_metrics_portfolio_order_idx")
  @@map("portfolio_metrics")
}

model ProjectVersion {
  id          String   @id @default(uuid())
  portfolioId String   @map("portfolio_id")
  year        Int
  version     String
  title       String
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, sortOrder], name: "project_versions_portfolio_order_idx")
  @@map("project_versions")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}
